# AI gateway
AI_GATEWAY_PROVIDER=kilo
AI_GATEWAY_URL=https://api.kilo.ai/api/gateway/chat/completions
AI_GATEWAY_HEALTH_URL=https://api.kilo.ai/api/gateway/models
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=kilo-auto/small
AI_GATEWAY_FALLBACKS_JSON=

# Persistent DEEP33 memory. Keep the anon key only in Render; never ship it in the APK.
DEEP33_MEMORY_URL=https://guqevsjbjyapqjjtutza.supabase.co/functions/v1/deep33-memory
SUPABASE_ANON_KEY=

# Runtime
PYTHON_VERSION=3.13.15

# Network
NETWORK_CHECK_URL=https://www.google.com/generate_204
NETWORK_TIMEOUT_SECONDS=8
AI_TIMEOUT_SECONDS=75

AI_PROVIDER_TIMEOUT_SECONDS=18
AI_PROVIDER_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=0.6
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=30
MEMORY_TIMEOUT_SECONDS=6
MEMORY_MAX_RETRIES=1
DEEP33_RATE_LIMIT_COUNT=60
DEEP33_RATE_LIMIT_WINDOW_SECONDS=60
DEEP33_CLIENT_AUTH_TOKEN=
DEEP33_BUILD_ID=
DEEP33_GIT_SHA=

# Real web navigation
DEEP33_WEB_TOOLS_ENABLED=true
DEEP33_WEB_ORCHESTRATOR=legacy
DEEP33_WEB_MAX_TOOL_ROUNDS=4
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_URL=https://api.tavily.com/search
WEB_SEARCH_FALLBACK_DDG=true
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_MIN_FALLBACK_RESULTS=3
WEB_SEARCH_PROVIDER_RETRIES=1
WEB_SEARCH_RETRY_BACKOFF_SECONDS=0.35
WEB_SEARCH_PARALLEL_PROVIDERS=false
WEB_SEARCH_BING_ENABLED=true
WEB_SEARCH_BING_URL=https://www.bing.com/search
WEB_FETCH_TIMEOUT_SECONDS=8
WEB_FETCH_MAX_REDIRECTS=3
WEB_FETCH_MAX_TEXT_CHARS=50000
WEB_FETCH_MAX_RESPONSE_BYTES=524288
WEB_FETCH_USER_AGENT=DEEP33-WebFetcher/1.0

# Hybrid knowledge search (pgvector + PostgreSQL full-text search)
DEEP33_HYBRID_SEARCH_ENABLED=false
DEEP33_KNOWLEDGE_DB_URL=
DEEP33_KNOWLEDGE_DB_KEY=
DEEP33_VECTOR_DIMENSIONS=1536
DEEP33_HYBRID_SEARCH_TIMEOUT_SECONDS=8
