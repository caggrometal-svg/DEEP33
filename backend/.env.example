# DEEP33 backend defaults to the keyless Kilo free gateway for initial connectivity proof.
AI_GATEWAY_PROVIDER=kilo
AI_GATEWAY_URL=https://api.kilo.ai/api/gateway/chat/completions
AI_GATEWAY_HEALTH_URL=https://api.kilo.ai/api/gateway/models
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=kilo-auto/free

# Optional ordered fallback providers. Keep credentials server-side only.
# Example shape:
# AI_GATEWAY_FALLBACKS_JSON=[{"name":"fallback-1","url":"https://example.invalid/chat/completions","health_url":"https://example.invalid/models","api_key":"","model":"example/model"}]
AI_GATEWAY_FALLBACKS_JSON=

NETWORK_CHECK_URL=https://www.google.com/generate_204
NETWORK_TIMEOUT_SECONDS=8
AI_TIMEOUT_SECONDS=45
